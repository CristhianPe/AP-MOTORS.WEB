rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Las imágenes se pueden leer desde la página pública.
    // Solo usuarios autenticados pueden subir/editar/eliminar archivos.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
